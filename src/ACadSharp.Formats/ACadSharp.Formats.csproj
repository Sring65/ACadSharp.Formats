<Project Sdk="Microsoft.NET.Sdk">

	<!-- [GDB2CAD PATCH] 本地克隆改造（T4：图+PDF 完全由 ACadSharp.Formats 实现）：
	     1) 目标框架收敛为 net10.0（与 GDB2CAD/ACadSharp fork 一致；原多目标 net8/net9/net48/netstandard2.1
        需要本仓库不存在的 ACadSharp.Formats.snk 签名密钥，SignAssembly 已移除）。
	     2) ACadSharp 依赖改为本地 fork 源码工程引用（原 Release 走 NuGet ACadSharp 3.8.*，
        与 fork 3.7.16 双程序集冲突，且 fork 含 100+ 补丁与 InternalsVisibleTo）。
	     3) 新增 SharpAstro.Fonts（Fonts.Lib）引用：复杂线型 SHX Shape 段的真实字形解析（T4.3）。
	     上游库 MIT（DomCR/ACadSharp.Formats）；GDB2CAD 专属导出器原在 Gdb\ 目录，R15 迁入对应
	     格式目录（Svg\FullSvgExporter、Pdf\FullPdfExporter、Image\FullImageEngine.*/ImageConfiguration/
	     TaperOffsetBuilder、Pdf\PdfFontManager/CjkFont），Gdb\ 已删除。 -->

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Authors>DomCr</Authors>
		<Description>Extension library for ACadSharp to export a dwg/dxf document into different media formats.</Description>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\ACadSharp\src\ACadSharp\ACadSharp.csproj" />
		<ProjectReference Include="..\..\..\Fonts.Lib\src\SharpAstro.Fonts\SharpAstro.Fonts.csproj" />
	</ItemGroup>

	<!-- [GDB2CAD PATCH] T4.9：PNG 光栅输出端（FullImageEngine.Png.cs）渲染后端。
	     仅 PNG 导出使用；SVG/PDF 输出路径不依赖此包（手写矢量文本/字节）。
	     原生库（libSkiaSharp）由包内 runtimes\ 按 RID 解析，随 CopyLocalLockFileAssemblies 部署。 -->
	<ItemGroup>
		<PackageReference Include="SkiaSharp" Version="3.119.4" />
		<!-- SHX bigfont（Hztxt.shx 等 CJK）按 GBK 双字节取字形码需要 936 编码；
		     与 ACadSharp fork（DwgSummaryInfoReader）同策略。 -->
		<PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
	</ItemGroup>

	<!-- [GDB2CAD PATCH] Json 导出器不参与编译：上游 Json 转换器依赖 NuGet ACadSharp 3.8 的
	     AecEntities 命名空间与 public CadDocumentBuilder，本地 fork 3.7.16 均无（T4 不需要 JSON 导出）。 -->
	<ItemGroup>
		<Compile Remove="Json\**" />
		<None Include="Json\**" />
	</ItemGroup>

</Project>
